{
  "expo": {
    "name": "sleepy-face",
    "slug": "sleepyface",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "sleepyface",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.team5.sleepyface",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 128,
          "resizeMode": "contain"
        }
      ],
      "./plugins/with-android-alarm-mechanics",
      [
        "expo-camera",
        {
          "cameraPermission": "起床確認とRealMoji用の顔写真を撮影するためにカメラを使用します。",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "photosPermission": "プロフィールアイコンに設定する写真を選ぶために写真ライブラリを使用します。"
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      "expo-localization",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "305843da-b8c6-435b-a06d-3abd34412469"
      }
    },
    "owner": "eisuke.s",
    "ios": {
      "bundleIdentifier": "com.team5.sleepyface"
    }
  }
}
